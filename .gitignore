__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/

# Environment Variables (SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.sqlite
*.sqlite3
*.db
robotics.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Node.js / Frontend (React + Vite)
# ==========================================
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite
.vite/

# ==========================================
# IDEs and Editors (VS Code, PyCharm, etc.)
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
